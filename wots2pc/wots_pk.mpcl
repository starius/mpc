// -*- go -*-

package main

import (
	"crypto/sha256"
)

const (
	wotsN    = 32
	wotsW    = 16
	wotsLogW = 4
	wotsLen  = 67

	addrTypeWOTS    = 0
	addrTypeWOTSPRF = 5

	addrOffsetType  = 9
	addrOffsetChain = 17
	addrOffsetHash  = 21
)

type Address [32]byte

func setType(addr *Address, t byte) {
	addr[addrOffsetType] = t
}

func setChain(addr *Address, c byte) {
	addr[addrOffsetChain] = c
}

func setHash(addr *Address, h byte) {
	addr[addrOffsetHash] = h
}

func prfAddr(pubSeed [wotsN]byte, skSeed [wotsN]byte, addr Address) [wotsN]byte {
	var buf [wotsN + 32 + wotsN]byte
	for i := 0; i < wotsN; i++ {
		buf[i] = pubSeed[i]
	}
	for i := 0; i < 32; i++ {
		buf[wotsN+i] = addr[i]
	}
	for i := 0; i < wotsN; i++ {
		buf[wotsN+32+i] = skSeed[i]
	}
	out := sha256.Sum256(buf[:])
	return out
}

func thash(pubSeed [wotsN]byte, addr Address, in [wotsN]byte) [wotsN]byte {
	var buf [wotsN + 32 + wotsN]byte
	for i := 0; i < wotsN; i++ {
		buf[i] = pubSeed[i]
	}
	for i := 0; i < 32; i++ {
		buf[wotsN+i] = addr[i]
	}
	for i := 0; i < wotsN; i++ {
		buf[wotsN+32+i] = in[i]
	}
	out := sha256.Sum256(buf[:])
	return out
}

func genChain(in [wotsN]byte, start, steps byte, pubSeed [wotsN]byte, addr Address) [wotsN]byte {
	out := in
	var h [wotsN]byte
	for i := start; i < start+steps && i < wotsW; i++ {
		setHash(&addr, i)
		h = thash(pubSeed, addr, out)
		for j := 0; j < wotsN; j++ {
			out[j] = h[j]
		}
	}
	return out
}

// main derives the WOTS+ public key (chain endpoints) with sk_seed = skSeedG ^
// skSeedE.
func main(skSeedG, skSeedE [wotsN]byte, pubSeed [wotsN]byte, addr Address) [wotsLen][wotsN]byte {
	var skSeed [wotsN]byte
	for i := 0; i < wotsN; i++ {
		skSeed[i] = skSeedG[i] ^ skSeedE[i]
	}
	var pk [wotsLen][wotsN]byte
	var addrPRF Address
	var addrChain Address
	var secret [wotsN]byte
	for i := 0; i < wotsLen; i++ {
		addrPRF = addr
		setChain(&addrPRF, byte(i))
		setHash(&addrPRF, 0)
		setType(&addrPRF, addrTypeWOTSPRF)
		secret = prfAddr(pubSeed, skSeed, addrPRF)

		addrChain = addrPRF
		setType(&addrChain, addrTypeWOTS)
		pk[i] = genChain(secret, 0, wotsW-1, pubSeed, addrChain)
	}
	return pk
}
