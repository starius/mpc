// -*- go -*-

package main

import (
	"crypto/sha256"
)

const (
	wotsN    = 32
	wotsW    = 16
	wotsLogW = 4
	wotsLen1 = 64
	wotsLen2 = 3
	wotsLen  = 67

	addrTypeWOTS    = 0
	addrTypeWOTSPRF = 5

	addrOffsetType  = 9
	addrOffsetChain = 17
	addrOffsetHash  = 21
)

type Address [32]byte

func setType(addr *Address, t byte) {
	addr[addrOffsetType] = t
}

func setChain(addr *Address, c byte) {
	addr[addrOffsetChain] = c
}

func setHash(addr *Address, h byte) {
	addr[addrOffsetHash] = h
}

func baseW(out *[wotsLen]byte, input [wotsN]byte) {
	in := 0
	bits := 0
	var total byte
	for i := 0; i < wotsLen1; i++ {
		if bits == 0 {
			total = input[in]
			in++
			bits = 8
		}
		bits -= wotsLogW
		out[i] = (total >> bits) & byte(wotsW-1)
	}
}

func wotsChecksum(out *[wotsLen]byte) {
	csum := uint16(0)
	for i := 0; i < wotsLen1; i++ {
		csum += uint16(wotsW-1) - uint16(out[i])
	}
	shift := uint(8 - ((wotsLen2 * wotsLogW) % 8)) % 8
	csum <<= shift

	var csumBytes [2]byte
	csumBytes[0] = byte(csum >> 8)
	csumBytes[1] = byte(csum)

	in := 0
	bits := 0
	var total byte
	for i := wotsLen1; i < wotsLen; i++ {
		if bits == 0 {
			total = csumBytes[in]
			in++
			bits = 8
		}
		bits -= wotsLogW
		out[i] = (total >> bits) & byte(wotsW-1)
	}
}

func chainLengths(msg [wotsN]byte) [wotsLen]byte {
	var lengths [wotsLen]byte
	baseW(&lengths, msg)
	wotsChecksum(&lengths)
	return lengths
}

func prfAddr(pubSeed [wotsN]byte, skSeed [wotsN]byte, addr Address) [wotsN]byte {
	var buf [wotsN + 32 + wotsN]byte
	for i := 0; i < wotsN; i++ {
		buf[i] = pubSeed[i]
	}
	for i := 0; i < 32; i++ {
		buf[wotsN+i] = addr[i]
	}
	for i := 0; i < wotsN; i++ {
		buf[wotsN+32+i] = skSeed[i]
	}
	out := sha256.Sum256(buf[:])
	return out
}

func thash(pubSeed [wotsN]byte, addr Address, in [wotsN]byte) [wotsN]byte {
	var buf [wotsN + 32 + wotsN]byte
	for i := 0; i < wotsN; i++ {
		buf[i] = pubSeed[i]
	}
	for i := 0; i < 32; i++ {
		buf[wotsN+i] = addr[i]
	}
	for i := 0; i < wotsN; i++ {
		buf[wotsN+32+i] = in[i]
	}
	out := sha256.Sum256(buf[:])
	return out
}

func genChain(in [wotsN]byte, start, steps byte, pubSeed [wotsN]byte, addr Address) [wotsN]byte {
	out := in
	var h [wotsN]byte
	for i := start; i < start+steps && i < wotsW; i++ {
		setHash(&addr, i)
		h = thash(pubSeed, addr, out)
		for j := 0; j < wotsN; j++ {
			out[j] = h[j]
		}
	}
	return out
}

// main computes a WOTS+ signature with sk_seed = skSeedG ^ skSeedE and a public
// message digest.
func main(skSeedG, skSeedE [wotsN]byte, pubSeed [wotsN]byte, addr Address, msg [wotsN]byte) [wotsLen][wotsN]byte {
	var skSeed [wotsN]byte
	for i := 0; i < wotsN; i++ {
		skSeed[i] = skSeedG[i] ^ skSeedE[i]
	}
	lengths := chainLengths(msg)
	var sig [wotsLen][wotsN]byte
	var addrPRF Address
	var addrSign Address
	var secret [wotsN]byte
	for i := 0; i < wotsLen; i++ {
		addrPRF = addr
		setChain(&addrPRF, byte(i))
		setHash(&addrPRF, 0)
		setType(&addrPRF, addrTypeWOTSPRF)
		secret = prfAddr(pubSeed, skSeed, addrPRF)

		addrSign = addrPRF
		setType(&addrSign, addrTypeWOTS)
		sig[i] = genChain(secret, 0, lengths[i], pubSeed, addrSign)
	}
	return sig
}
